# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=8h

# Database
# Local dev default: SQLite file (zero-config).
#   DB_CLIENT=sqlite3
#   SQLITE_FILE=./data/lh_transport.sqlite3
#
# Vercel / production: SQLite is NOT usable on Vercel (the filesystem is
# read-only and reset on every cold start, so data would not persist, and
# the native better-sqlite3 binary is not guaranteed to build in the
# serverless bundle). Use Postgres instead - Vercel Postgres, Neon, and
# Supabase all work fine with the existing knexfile.
#   DB_CLIENT=pg
#   DATABASE_URL=postgres://user:password@host:5432/lh_transport?sslmode=require
DB_CLIENT=sqlite3
SQLITE_FILE=./data/lh_transport.sqlite3
DATABASE_URL=

# CORS - the URL(s) your client runs on. Comma-separate multiple origins
# (e.g. production + a Vercel preview URL).
# Local:      http://localhost:5173
# Production: https://lh-transport-client.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
