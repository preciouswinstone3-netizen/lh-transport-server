# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=8h

# Database
# Default: SQLite file (zero-config, great for demo/dev).
# To use PostgreSQL instead, set DB_CLIENT=pg and DATABASE_URL to your connection string,
# e.g. postgres://user:password@localhost:5432/lh_transport
DB_CLIENT=sqlite3
SQLITE_FILE=./data/lh_transport.sqlite3
DATABASE_URL=

# CORS - the URL your client dev server / production build runs on
CLIENT_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
