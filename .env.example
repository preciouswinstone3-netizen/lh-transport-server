# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=8h

# Database - Supabase Postgres only. This app has no local/SQLite mode;
# DATABASE_URL is required and the app will fail to start without it.
#
# Get this from Supabase dashboard -> Connect -> Session pooler (works over
# normal IPv4 - the "direct connection" host requires IPv6, which many
# networks don't support and will fail with ENOTFOUND).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-region.pooler.supabase.com:5432/postgres

# CORS - the URL(s) your client runs on, comma-separated for multiple
CLIENT_ORIGIN=http://localhost:5173

# Email (SMTP) - used for password reset emails. Configured here for Gmail;
# works with any SMTP provider if you swap providers later. If left unset,
# reset links are logged to the server console instead of emailed, which is
# fine for local development.
#
# To get SMTP_PASS: enable 2-Step Verification on the Gmail account, then
# create an App Password at https://myaccount.google.com/apppasswords and
# paste the 16-character password below (spaces don't matter).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="LH Transport <your-gmail-address@gmail.com>"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
